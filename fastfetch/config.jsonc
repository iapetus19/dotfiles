{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "iterm",
    "source": "~/.config/fastfetch/assets/firewatch.png",
    "width": 42,
    "padding": {
      "right": 5
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󰣇 OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    "break",
    {
      "type": "shell",
      "key": "󰆍 Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    "break",
    {
      "type": "cpu",
      "key": "󰻠 CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰍛 Memory"
    },
    {
      "type": "disk",
      "key": "󰋊 Disk"
    },
    {
      "type": "battery",
      "key": "󰁹 Battery"
    },
    "break",
    "colors"
  ]
}
