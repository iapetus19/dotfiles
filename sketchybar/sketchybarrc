#!/bin/bash

CONFIG_DIR="$HOME/.config/sketchybar"

source "$CONFIG_DIR/colors.sh"
source "$CONFIG_DIR/fonts.sh"
source "$CONFIG_DIR/icons.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"

sketchybar --bar \
    position=top \
    height=38 \
    blur_radius=45 \
    color=$BAR_COLOR \
    corner_radius=14 \
    margin=10 \
    sticky=on \
    topmost=window

sketchybar --default \
    icon.color=$WHITE \
    label.color=$WHITE \
    icon.font="$FONT_ICON" \
    label.font="$FONT_LABEL" \
    background.height=30 \
    background.corner_radius=12 \
    icon.padding_left=8 \
    icon.padding_right=8 \
    label.padding_left=4 \
    label.padding_right=4 \
    padding_left=4 \
    padding_right=4 \
    scroll_texts=on

source "$CONFIG_DIR/items/apple.sh"
source "$CONFIG_DIR/items/launchers.sh"
source "$CONFIG_DIR/items/media.sh"
source "$CONFIG_DIR/items/battery.sh"
source "$CONFIG_DIR/items/volume.sh"
source "$CONFIG_DIR/items/clock.sh"

sketchybar --update
