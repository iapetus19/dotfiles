#!/bin/bash

source "$HOME/Developer/dotfiles/sketchybar/colors.sh"
source "$HOME/Developer/dotfiles/sketchybar/icons.sh"

ITEM_DIR="$HOME/Developer/dotfiles/sketchybar/items"
PLUGIN_DIR="$HOME/Developer/dotfiles/sketchybar/plugins"

FONT="SF Pro"
PADDINGS=4

# Setting up and starting the helper process
HELPER=git.felix.helper
killall helper 2>/dev/null
cd $HOME/Developer/dotfiles/sketchybar/helper && make > /dev/null 2>&1
$HOME/Developer/dotfiles/sketchybar/helper/helper $HELPER > /dev/null 2>&1 &

launchctl unload -F /System/Library/LaunchAgents/com.apple.OSDUIHelper.plist > /dev/null 2>&1 &

# Full-width Edge-to-Edge Navbar (no left/right gaps!)
bar=(
  height=38
  color=0xff261e1b
  border_width=0
  corner_radius=0
  shadow=off
  position=top
  sticky=on
  padding_right=12
  padding_left=12
  y_offset=0
  margin=0
)

sketchybar --bar "${bar[@]}"

defaults=(
  updates=when_shown
  icon.font="$FONT:Bold:14.0"
  icon.color=$ICON_COLOR
  icon.padding_left=5
  icon.padding_right=5
  label.font="$FONT:Semibold:12.5"
  label.color=$LABEL_COLOR
  label.padding_left=4
  label.padding_right=5
  padding_right=4
  padding_left=4
  background.drawing=off
  background.height=24
  background.corner_radius=6
  background.border_width=0
  background.shadow.drawing=off
  popup.background.border_width=1
  popup.background.corner_radius=6
  popup.background.border_color=$YELLOW
  popup.background.color=$POPUP_BACKGROUND_COLOR
)

sketchybar --default "${defaults[@]}"

# Left of Notch
source "$ITEM_DIR/apple.sh"
source "$ITEM_DIR/spaces.sh"
source "$ITEM_DIR/front_app.sh"

# Right of Notch
source "$ITEM_DIR/calendar.sh"
source "$ITEM_DIR/battery.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/cpu.sh"
source "$ITEM_DIR/spotify.sh"

sketchybar --update
echo "sketchybar configuration loaded.."
